# Scan the fixed Player hotbar and main-inventory slot map once per matured inventory-change event.
# Item command slots and readable Player NBT paths are separate values intentionally paired here.
execute if items entity @s hotbar.0 #named_heads:supported_heads[minecraft:custom_name] run function named_heads:core/convert {slot:"hotbar.0",path:"Inventory[{Slot:0b}]"}
